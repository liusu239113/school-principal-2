<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:keepScreenOn="true">

    <!-- 3D 校园场景 -->
    <com.principal.school2.GLGameView
        android:id="@+id/gameView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 顶部资源栏 -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:background="@drawable/bar_bg"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/moneyText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.2"
            android:text="💰 5000"
            android:textColor="@color/textLight"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/studentText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🎓 20/60"
            android:textColor="@color/textLight"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/fameText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="⭐ 10"
            android:textColor="@color/textLight"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/happyText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="😊 60"
            android:textColor="@color/textLight"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/dayText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="第1学期"
            android:textColor="@color/textSoft"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- 事件消息条 -->
    <TextView
        android:id="@+id/eventText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="58dp"
        android:background="@drawable/event_bg"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:textSize="13sp"
        android:textColor="@color/textLight"
        android:visibility="gone" />

    <!-- 内容面板(任务/师资/学校) -->
    <LinearLayout
        android:id="@+id/contentPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@drawable/panel_bg"
        android:padding="10dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/contentTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:gravity="center"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/textLight" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="vertical">

            <LinearLayout
                android:id="@+id/contentList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>

    <!-- 选中建筑信息面板 -->
    <LinearLayout
        android:id="@+id/infoPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@drawable/panel_bg"
        android:padding="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/infoTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="17sp"
            android:textColor="@color/textLight"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/infoDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="13sp"
            android:textColor="@color/textSoft" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/upgradeBtn"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/btn_primary"
                android:text="升级"
                android:textColor="@color/textLight"
                android:textSize="15sp"
                android:stateListAnimator="@null" />

            <Button
                android:id="@+id/demolishBtn"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/btn_danger"
                android:text="拆除"
                android:textColor="@color/textLight"
                android:textSize="15sp"
                android:stateListAnimator="@null" />

            <Button
                android:id="@+id/closeInfoBtn"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/btn_gray"
                android:text="关闭"
                android:textColor="@color/textLight"
                android:textSize="15sp"
                android:stateListAnimator="@null" />
        </LinearLayout>
    </LinearLayout>

    <!-- 底部建造栏(校园 tab) -->
    <LinearLayout
        android:id="@+id/buildBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="56dp"
        android:orientation="vertical"
        android:background="@drawable/panel_bg"
        android:padding="10dp">

        <TextView
            android:id="@+id/hintText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:gravity="center"
            android:text="👆 点击建筑查看/升级 · 拖动旋转视角 · 建造设施扩大校园"
            android:textColor="@color/textSoft"
            android:textSize="12sp" />

        <Button
            android:id="@+id/buildBtn"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="@drawable/btn_primary"
            android:text="🏗️ 建造设施"
            android:textColor="@color/textLight"
            android:textSize="16sp"
            android:stateListAnimator="@null" />
    </LinearLayout>

    <!-- 建造面板 -->
    <LinearLayout
        android:id="@+id/buildPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="56dp"
        android:orientation="vertical"
        android:background="@drawable/panel_bg"
        android:padding="10dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:gravity="center"
            android:text="选择要建造的设施(自动放置到空地)"
            android:textColor="@color/textLight"
            android:textSize="14sp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/buildingList"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <Button
            android:id="@+id/closeBuildBtn"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/btn_gray"
            android:text="关闭"
            android:textColor="@color/textLight"
            android:textSize="15sp"
            android:stateListAnimator="@null" />
    </LinearLayout>

    <!-- 底部导航栏 -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:background="@drawable/nav_bg">

        <Button
            android:id="@+id/tabCampus"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/btn_tab"
            android:text="🏫 校园"
            android:textColor="@color/textLight"
            android:textSize="13sp"
            android:stateListAnimator="@null" />

        <Button
            android:id="@+id/tabTasks"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/btn_tab"
            android:text="📋 任务"
            android:textColor="@color/textLight"
            android:textSize="13sp"
            android:stateListAnimator="@null" />

        <Button
            android:id="@+id/tabStaff"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/btn_tab"
            android:text="🎓 师资"
            android:textColor="@color/textLight"
            android:textSize="13sp"
            android:stateListAnimator="@null" />

        <Button
            android:id="@+id/tabSchool"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/btn_tab"
            android:text="🏆 学校"
            android:textColor="@color/textLight"
            android:textSize="13sp"
            android:stateListAnimator="@null" />
    </LinearLayout>

</FrameLayout>
